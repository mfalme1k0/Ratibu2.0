+
+    /**
+     * Test double: overrides {@link CreateBusinessService#execute} without Mockito.
+     */
+    static final class StubCreateBusinessService extends CreateBusinessService {
+
+        private Function<CreateBusinessCommand, CreateBusinessResult> handler =
+                cmd -> {
+                    throw new IllegalStateException("Stub not configured; call onExecute(...)");
+                };
+
+        StubCreateBusinessService() {
+            super(NoOpBusinessRepository.INSTANCE);
+        }
+
+        void onExecute(Function<CreateBusinessCommand, CreateBusinessResult> handler) {
+            this.handler = handler;
+        }
+
+        void reset() {
+            this.handler = cmd -> {
+                throw new IllegalStateException("Stub not configured; call onExecute(...)");
+            };
+        }
+
+        @Override
+        public CreateBusinessResult execute(CreateBusinessCommand command) {
+            return handler.apply(command);
+        }
+    }
+
+    private enum NoOpBusinessRepository implements BusinessRepository {
+        INSTANCE;
+
+        @Override
+        public Business save(Business business) {
+            return business;
+        }
+
+        @Override
+        public Optional<Business> findById(StableId id) {
+            return Optional.empty();
+        }
+
+        @Override
+        public boolean existsById(StableId id) {
+            return false;
+        }
+    }
+
+    @org.springframework.boot.test.context.TestConfiguration
+    static class StubConfig {
+        @Bean
+        @Primary
+        StubCreateBusinessService stubCreateBusinessService() {
+            return new StubCreateBusinessService();
+        }
+    }
 }
